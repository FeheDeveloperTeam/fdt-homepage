# Discord OAuth and bot API
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
SESSION_SECRET=

# Optional comma-separated root administrator IDs
ADMIN_DISCORD_IDS=

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chiyumi data over SFTP (SFTP_PORT defaults to 22)
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=

# Google Sheets read-only access
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional Express port (defaults to 3000)
PORT=
