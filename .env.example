# Firebase (member/fehe 서브트리에서 사용)
FIREBASE_DB_SECRET=
VITE_IMGBB_KEY=

# Discord OAuth 로그인 (/DiscordBot/Chiyumi)
# 1. https://discord.com/developers/applications 에서 치유미 봇 앱 선택
# 2. OAuth2 탭 → Client Secret "Reset Secret" 후 복사 → DISCORD_CLIENT_SECRET
# 3. 같은 탭의 Redirect URIs에 아래 두 개를 추가:
#    - http://localhost:3000/api/auth/discord/callback
#    - https://www.fehe.dev/api/auth/discord/callback
# 4. DISCORD_CLIENT_ID는 봇 초대 링크에 이미 쓰이는 값과 동일 (1517170922732388423)
DISCORD_CLIENT_ID=1517170922732388423
DISCORD_CLIENT_SECRET=

# 세션 쿠키 서명용 — 아무 임의의 긴 문자열이면 됨 (예: openssl rand -hex 32)
SESSION_SECRET=
